# Mindestens 12 Zeichen. Mit einem Passwortmanager erzeugen.
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
DASHBOARD_TITLE=App Dashboard

# Lokaler Reverseproxy: http://127.0.0.1:8080
BIND_ADDRESS=127.0.0.1
PORT=8080

# Öffentlich erreichbare HTTPS-Adresse ohne abschließenden Slash.
PUBLIC_ORIGIN=https://apps.example.de
SECURE_COOKIE=true
# Anzahl vertrauenswürdiger Proxys vor dem Container (meist 1).
TRUSTED_PROXY_HOPS=1

# true erlaubt den Admin-Metadatenabruf auch aus privaten LAN-Netzen.
# Loopback- und Link-Local-Adressen bleiben gesperrt.
ALLOW_PRIVATE_METADATA=false

# Optional: eine konkrete Version oder einen Digest statt latest verwenden.
APP_DASHBOARD_IMAGE=ghcr.io/phillipunzen/app-dashboard:latest
